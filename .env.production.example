# Copy to .env.production for Docker Compose backend deploys, or enter these
# values in Render's dashboard/Blueprint secret prompts. Do not commit real values.

# Public domains for MerebHub production
PUBLIC_MIDDLEWARE_URL=https://license-api.merebhub.com
PUBLIC_KEYGEN_URL=https://keygen.merebhub.com
WORDPRESS_URL=https://merebhub.com

# Keygen CE
KEYGEN_EDITION=CE
KEYGEN_MODE=singleplayer
KEYGEN_HOST=keygen.merebhub.com
KEYGEN_HOSTS=keygen.merebhub.com,merebhub-keygen-api.onrender.com,keygen-api:3000,keygen-api
KEYGEN_ACCOUNT_ID=replace-with-keygen-account-uuid
KEYGEN_ADMIN_EMAIL=admin@example.com
KEYGEN_ADMIN_PASSWORD=replace-with-strong-admin-password
KEYGEN_ADMIN_TOKEN=replace-with-keygen-admin-api-token
SECRET_KEY_BASE=replace-with-output-of-openssl-rand-hex-64
ENCRYPTION_PRIMARY_KEY=replace-with-output-of-openssl-rand-base64-32
ENCRYPTION_DETERMINISTIC_KEY=replace-with-output-of-openssl-rand-base64-32
ENCRYPTION_KEY_DERIVATION_SALT=replace-with-output-of-openssl-rand-base64-32
RAILS_ENV=production
RAILS_SERVE_STATIC_FILES=enabled
RAILS_LOG_TO_STDOUT=enabled

# PostgreSQL. For Render, use the managed Postgres internal connection string.
POSTGRES_USER=keygen_pg_user
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=keygen_production
DATABASE_URL=postgres://keygen_pg_user:replace-with-strong-postgres-password@keygen-db:5432/keygen_production

# Redis / Render Key Value
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@keygen-redis:6379/1

# FastAPI middleware
KEYGEN_API_URL=http://keygen-api:3000/v1
MIDDLEWARE_PORT=8000
KEYGEN_PORT=3000

# Hosted WooCommerce REST API keys with Read/Write permissions
WOOCOMMERCE_URL=https://merebhub.com
WOOCOMMERCE_CONSUMER_KEY=ck_replace_with_hosted_store_key
WOOCOMMERCE_CONSUMER_SECRET=cs_replace_with_hosted_store_secret

# Chapa, only if middleware directly verifies/provisions Chapa flows
CHAPA_SECRET_KEY=replace-with-chapa-secret-key
CHAPA_PUBLIC_KEY=replace-with-chapa-public-key
CHAPA_ENCRYPTION_KEY=replace-with-real-encryption-key
